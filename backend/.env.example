# Copie este archivo a .env y complete los valores. NUNCA suba .env al repositorio.

# development | production. En producción el servidor no arranca con configuración insegura.
ENVIRONMENT=development

# Base de datos. SQLite para desarrollo; PostgreSQL en producción:
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/agrobolivia
DATABASE_URL=sqlite:///./agrobolivia.db

# Clave para firmar tokens de sesión (genere una con: python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=cambie-esta-clave
TOKEN_EXPIRE_MINUTES=10080

# Orígenes permitidos para el frontend (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Administrador inicial (se crea al iniciar si no existe)
ADMIN_PHONE=+59170000000
ADMIN_PASSWORD=cambie-esta-clave

# Cargar cuentas y comunidad de demostración (ficticias, marcadas como DEMO)
SEED_DEMO=true

# Fuentes meteorológicas
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# Clave del plan pagado de Open-Meteo (uso comercial o más consultas). Vacía = plan gratuito no comercial.
OPEN_METEO_API_KEY=
NASA_POWER_URL=https://power.larc.nasa.gov/api/temporal
WEATHER_TIMEOUT_SECONDS=12

# WhatsApp Business Platform (Cloud API). Si WHATSAPP_ENABLED=false se usa el simulador.
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Nombres de plantillas aprobadas en Meta (por defecto: recordatorio_reunion, aviso_regional)
WHATSAPP_TEMPLATE_MEETING=
WHATSAPP_TEMPLATE_NOTICE=

# Fuente meteorológica oficial con contrato normalizado (opcional; ver docs/FUENTES_DATOS.md).
# Si se configura, se usa primero y Open-Meteo queda como respaldo.
OFFICIAL_WEATHER_URL=
OFFICIAL_WEATHER_KEY=

# Asesoría con IA (Claude). Vacía = respuesta automática básica.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5

# Alternativa para Pacha IA (opcional): Gemini. Se usa solo si no hay ANTHROPIC_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
